// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = ".\\..\\node_modules\\.prisma\\client"//"../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model usuario {
  id           Int       @id @default(autoincrement())
  nombre       String    @db.VarChar(100)
  apellido     String    @db.VarChar(100)
  nroDocumento String    @db.VarChar(8)
  telefono     String    @db.VarChar(20)
  nroTramite   String    @db.VarChar(11)
  genero       String    @db.VarChar(1)
  fchNacimiento DateTime @db.DateTime(0)
  mail         String    @unique @db.VarChar(255)
  password     String    @db.VarChar(255)
  validado     Boolean   @default(false)
  activo       Boolean   @default(true)
  fechaCreacion DateTime  @default(now()) @db.DateTime(0)
  ultimoAcceso DateTime? @db.DateTime(0)

  esAdmin      Boolean   @default(false)

  // Relaciones
  preferencias   usuarioPreferencia[]
  adicionales usuarioAdicional[]
  alertas       alerta[]
  asistentes     asistente[]
  notificaciones notificacion[]
  // Contactos donde este usuario es el propietario
  contactos      contacto[] @relation("UsuarioContactos")
  // Contactos donde este usuario es el contacto de otros
  esContactoDe   contacto[] @relation("ContactoUsuario")
  // Invitaciones enviadas
  invitacionesEnviadas invitacion[] @relation("InvitacionesEnviadas")

  // Índices
  @@index([activo])
  @@index([mail])
  @@index([nroDocumento])
}

model alerta {
  id Int @default(autoincrement())
  usuarioId Int
  usuario usuario @relation(fields: [usuarioId], references: [id])
  latitud Float
  longitud Float
  estado String @default("E") @db.Char(1)
  fchEmision DateTime @default(now()) @db.DateTime(0)
  fchCierre DateTime? @db.DateTime(0)
  cerrada Boolean @default(false)

  asistentes asistente[]

  @@id(id)
}

model asistente {
  alertaId Int
  alerta alerta @relation(fields: [alertaId], references: [id])
  usuarioId Int
  usuario usuario @relation(fields: [usuarioId], references: [id])
  estado String @db.Char(1)
  observacion String?

  @@id([alertaId, usuarioId])
}

model notificacion {
  id Int @default(autoincrement())
  usuarioId Int
  usuario usuario @relation(fields: [usuarioId], references: [id])
  fchEmision DateTime @default(now())
  leida Boolean @default(false)

  @@id(id)
}

model usuarioPreferencia {
  usuarioId Int
  usuario usuario @relation(fields: [usuarioId], references: [id])
  clave String

  @@id([usuarioId, clave])
}


// Tabla donde almacenar datos adicionales de los usuarios
// Ejemplo: preferencias de notificación, token de notificacion, codigo de recuperacion, etc.

model usuarioAdicional {
  usuarioId Int
  usuario usuario @relation(fields: [usuarioId], references: [id])
  clave String
  valor String

  @@id([usuarioId, clave])
}

model contacto {
  id Int @default(autoincrement())
  usuarioId Int // El usuario que tiene el contacto
  contactoId Int // El usuario que es el contacto
  estado String @default("P") @db.Char(1) // P=Pendiente, A=Aceptado, R=Rechazado
  activo Boolean @default(true) // Si se notifica a este contacto o no
  eliminado Boolean @default(false) // Soft delete
  fchCreacion DateTime @default(now()) @db.DateTime(0)
  fchActualizacion DateTime @updatedAt @db.DateTime(0)
  fchEliminacion DateTime? @db.DateTime(0) // Fecha de eliminación lógica
  fchRespuesta DateTime? @db.DateTime(0) // Fecha cuando aceptó/rechazó

  // Relaciones
  usuario usuario @relation("UsuarioContactos", fields: [usuarioId], references: [id])
  contactoUsuario usuario @relation("ContactoUsuario", fields: [contactoId], references: [id])

  // Índices
  @@id(id)
  @@unique([usuarioId, contactoId]) // Un usuario no puede tener el mismo contacto duplicado
  @@index([usuarioId])
  @@index([contactoId])
  @@index([estado])
  @@index([activo])
  @@index([eliminado])
}

// Tabla para invitaciones de contacto por email
model invitacion {
  id Int @default(autoincrement())
  usuarioId Int // Usuario que envía la invitación
  email String @db.VarChar(255) // Email del invitado
  telefono String? @db.VarChar(20) // Teléfono del invitado (opcional, para futuro)
  codigo String @unique @db.VarChar(50) // Código único de invitación para el link/QR
  estado String @default("P") @db.Char(1) // P=Pendiente, A=Aceptada, R=Rechazada, E=Expirada
  mensaje String? @db.Text // Mensaje personalizado opcional
  fchCreacion DateTime @default(now()) @db.DateTime(0)
  fchExpiracion DateTime @db.DateTime(0) // Fecha de expiración (ej: 7 días)
  fchRespuesta DateTime? @db.DateTime(0) // Cuando aceptó/rechazó
  usuarioRegistradoId Int? // Usuario que aceptó la invitación (si se registró)
  
  // Relaciones
  usuario usuario @relation("InvitacionesEnviadas", fields: [usuarioId], references: [id])
  
  // Índices
  @@id(id)
  @@index([usuarioId])
  @@index([email])
  @@index([codigo])
  @@index([estado])
}